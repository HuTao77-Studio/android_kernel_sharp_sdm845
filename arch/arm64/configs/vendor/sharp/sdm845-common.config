# Battery
CONFIG_BATTERY_SHARP=y
CONFIG_PM_SUPPORT_BATT_TRACEABILITY=y
CONFIG_QPNP_QNOVO=n
CONFIG_SHARP_BATTERY_MODULE=m

# Boot
CONFIG_SHARP_BOOT=y

# Debug
CONFIG_DEBUG_BUGVERBOSE=n
CONFIG_SHARP_SHLOG=y
CONFIG_SHARP_SHLOG_LATESTSTACK=y
CONFIG_SHARP_SHLOG_RAMOOPS=y
CONFIG_SHARP_SHLOG_SHOW_ABOOTLOG=y
CONFIG_SHARP_SHLOG_TASKLIST=y
CONFIG_SHARP_HANDLE_PANIC=y
CONFIG_SHARP_HANDLE_SURFACE_FLINGER=y
CONFIG_SHARP_PANIC_ON_PWRKEY=y
CONFIG_SHARP_PANIC_ON_PWRKEY_TIMEOUT=8
CONFIG_SHARP_SUPPORT_DLOAD_BOOTPARAM=y
CONFIG_DYNAMIC_DEBUG=y
CONFIG_PANIC_TIMEOUT=1

# Diag
CONFIG_SHARP_SHDIAG_SMD=y
CONFIG_SHARP_SMEM_CUST=y

# Display
CONFIG_SHARP_DISPLAY=y
CONFIG_FRAME_VECTOR=y

# DTBO
CONFIG_BUILD_ARM64_DT_OVERLAY=y

# Fingerprint
CONFIG_SENSORS_FINGERPRINT=y
CONFIG_SENSORS_FPRINT_SHARP_CUSTOMIZE=y

# Input
CONFIG_INPUT_JOYSTICK=y
CONFIG_INPUT_MOUSEDEV=n
CONFIG_JOYSTICK_XPAD=y
CONFIG_SERIO=n

# Keyboard
CONFIG_KEYBOARD_ATKBD=y
CONFIG_KEYBOARD_GPIO_CUST_SC=y

# LED
CONFIG_LEDS_SHARP=y
CONFIG_LEDS_SHARP_QPNP_HAPTIC=y

# MMC
CONFIG_MMC_TEST=n
CONFIG_SHARP_MMC=y
CONFIG_SHARP_MMC_SD=y
CONFIG_SHARP_MMC_SD_BATTLOG=y
CONFIG_SHARP_MMC_SD_DISABLE_CLK_SCALE=y
CONFIG_SHARP_MMC_SD_ECO_MODE=y
CONFIG_SHARP_MMC_SD_ENABLE_ONLY_DDR50=y

# NFC
CONFIG_NFC=y
CONFIG_NFC_NQ=n
CONFIG_NFC_CXD224X=m
CONFIG_NFC_CXD224X_RST_USE_PMIC=y

# Persistent store
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_RAM=y

# Power
CONFIG_SHARP_PNP=y

# Proximity
CONFIG_PROXIMITY_CHECKER=m

# Psals
CONFIG_SHARP_PSALS_SMEM_READ=y

# SCSI
CONFIG_SHARP_SCSI_UFS=y
CONFIG_SHARP_SCSI_UFS_BUG_FIX=y
CONFIG_SHARP_SCSI_UFS_ERR_DETECT=y
CONFIG_SHARP_SCSI_UFS_LOG=y
CONFIG_SHARP_SCSI_UFS_WP=y

# Time
CONFIG_SHARP_SHTIMER=y
CONFIG_SHARP_SYSTIME_CUST=y

# Touchscreen
CONFIG_INPUT_QPNP_SCPOWER_ON=y
CONFIG_SHARP_TPS_SY3X00_DEV=y
CONFIG_TOUCHSCREEN_SHARP_TPS=y
CONFIG_TOUCHSCREEN_SYNAPTICS_DSX=n
CONFIG_TOUCHSCREEN_SYNAPTICS_DSX_v26=n

# USB
CONFIG_MEDIA_USB_SUPPORT=y
CONFIG_USB_ANDROID_SHARP_CUST=y
CONFIG_USB_ANDROID_SHARP_MTP=y
CONFIG_USB_ANDROID_SHARP_SERIALS=y
CONFIG_USB_ANDROID_SHARP_UMS=y
CONFIG_USB_DWC3_LIMIT_LOCK=y
CONFIG_USB_DWC3_SHARP_CUST=y
CONFIG_USB_VIDEO_CLASS=y

# WLAN
CONFIG_WIL6210=n
CONFIG_SHARP_WLAN_FACTORY=m
