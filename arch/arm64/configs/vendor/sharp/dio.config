# Platform
CONFIG_ARCH_DIO=y

# Audio
CONFIG_SND_SOC_NXP_CHIP=y
CONFIG_SND_SOC_NXP_TFA98XX=m

# Display
CONFIG_SHARP_DRM_HR_VID=y
CONFIG_SHARP_FLIP=m

# DTV
CONFIG_SHARP_DTV_TUNERDEV_FSEG=m

# Fingerprint
CONFIG_SENSORS_FPRINT_FPC_PLATFORM_1145=m

# LED
CONFIG_LEDS_QPNP_WLED=y

# Touchscreen
CONFIG_SHARP_TPS_SY3000_PRJ_001860=y
